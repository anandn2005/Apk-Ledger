<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="7dp">

    <!-- Left: Item Name (bold, prominent) & unit -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Item Name"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Per Kg"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Right: Sell Price (Primary accent color) and Buy Price (Muted gray, smaller) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_sell_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹140-145"
            android:textColor="#818CF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_buy_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buy: ₹120"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
